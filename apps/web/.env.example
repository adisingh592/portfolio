# Leave empty in development (Vite proxies /api to the backend).
# Set to the deployed API origin in production, e.g. https://api.example.com
VITE_API_URL=

# Set to "true" only once the API actually emails contact messages
# (apps/api/src/services/mail.service.ts). Until then the form never claims a message was sent.
VITE_CONTACT_ENABLED=false
